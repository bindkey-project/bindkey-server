{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            s.auth_challenge, \n            b.public_key, \n            u.first_name, \n            u.role as \"role: String\"\n        FROM sessions s\n        JOIN users u ON s.user_id = u.id\n        JOIN bindkeys b ON s.bindkey_id = b.id\n        WHERE s.id = $1 AND s.expires_at > NOW()\n        ",
