{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            u.id as user_id, u.password_hash, u.first_name, u.role as \"role: String\",\n            b.id as bindkey_id \n        FROM users u\n        INNER JOIN bindkeys b ON u.id = b.user_id\n        WHERE u.email = $1\n        ",
