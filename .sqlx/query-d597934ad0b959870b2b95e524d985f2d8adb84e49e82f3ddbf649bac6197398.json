{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id as session_id,\n            s.user_id,\n            s.bindkey_id,\n            u.first_name,\n            u.role as \"role: String\"\n        FROM sessions s\n        INNER JOIN users u ON s.user_id = u.id\n        WHERE s.server_token = $1\n        ",
